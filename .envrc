# Settings for the justfile. Put personal overrides in .envrc.local (not committed), e.g.:
#   export HIRTE_DEVICE=00000000-0000000000000000   # from `just devices`
#   More devices by name, for `just phone ipad`:
#   export HIRTE_DEVICE_IPAD=00000000-0000000000000000
#   To build with your own Apple developer team (Xcode → Settings → Accounts):
#   export HIRTE_TEAM=XXXXXXXXXX
#   export HIRTE_BUNDLE_ID_PREFIX=com.example
#   export HIRTE_SIMULATOR="iPhone 17 Pro"
#   For `just archive`: an App Store Connect API key (App Store Connect → Users and Access →
#   Integrations → App Store Connect API, role Admin, which cloud signing needs), stored
#   sops-encrypted in .appstoreconnect.sops.yaml (not committed) with the keys key_id, issuer_id and
#   private_key (the .p8's content), and your age key for sops:
#   export SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt
export HIRTE_SIMULATOR="${HIRTE_SIMULATOR:-iPhone 17 Pro}"

source_env_if_exists .envrc.local
